<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ejemplos compilados de lo que el inspector de IL debe detectar. Nunca se cargan ni se ejecutan:
    ningún proyecto se enlaza con este ensamblado y la suite aislada solo lee sus bytes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0436;CS0618;ASPDEPR004;ASPDEPR008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marrow.API\Marrow.API.csproj" />
    <ProjectReference Include="..\Marrow.API.IntegrationTests.Infraestructura\Marrow.API.IntegrationTests.Infraestructura.csproj" />
  </ItemGroup>

</Project>
