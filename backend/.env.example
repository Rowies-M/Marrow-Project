# Variables de entorno del backend en producción. Son solo un ejemplo: .NET no lee este archivo.
# Cargá los valores reales en el panel del proveedor. Nunca los subas al repositorio.

ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexión a PostgreSQL, en formato clave=valor. No uses la URI postgresql:// que muestra Neon.
# En Neon, TU_HOST es el host directo (sin -pooler). Ver docs/DESPLIEGUE.md.
ConnectionStrings__MarrowDatabase=Host=TU_HOST;Port=5432;Database=TU_BASE;Username=TU_USUARIO;Password=TU_CONTRASEÑA;SSL Mode=Require

# Clave para firmar los JWT: al menos 32 bytes y aleatoria. Si cambia, se cierran las sesiones abiertas.
Jwt__SigningKey=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES

# Dominio exacto del frontend desplegado: con https y sin barra final.
Cors__AllowedOrigins__0=https://tu-frontend.example

# Opcional: crea el primer administrador al arrancar. Sin estos tres valores, no se crea ninguno.
# AdministradorInicial__NombreUsuario=REEMPLAZAR
# AdministradorInicial__Email=REEMPLAZAR
# AdministradorInicial__Password=REEMPLAZAR

# Opcional: puerto en el que escucha la API, si el proveedor lo requiere.
# ASPNETCORE_HTTP_PORTS=8080
