@baseUrl = https://localhost:7199
@password = {{$dotenv MARROW_TEST_PASSWORD}}
@token = {{$dotenv MARROW_TEST_TOKEN}}

### Registrar usuario
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nombreUsuario": "guerrero1",
  "email": "guerrero1@example.com",
  "password": "{{password}}"
}

### Iniciar sesión con nombre de usuario
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usuario": "guerrero1",
  "password": "{{password}}"
}

### Ejemplo de petición autenticada para el próximo bloque
GET {{baseUrl}}/api/enemigos
Authorization: Bearer {{token}}

### Crear personaje
POST {{baseUrl}}/api/personajes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Arthas",
  "nivel": 1,
  "experiencia": 0,
  "vidaActual": 100,
  "vidaMaxima": 100,
  "ataque": 10,
  "defensa": 5,
  "clase": 0
}

### Listar personajes propios
GET {{baseUrl}}/api/personajes
Authorization: Bearer {{token}}

### Obtener personaje propio
GET {{baseUrl}}/api/personajes/{{personajeId}}
Authorization: Bearer {{token}}

### Actualizar personaje propio
PUT {{baseUrl}}/api/personajes/{{personajeId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Arthas",
  "nivel": 2,
  "experiencia": 25,
  "vidaActual": 110,
  "vidaMaxima": 110,
  "ataque": 12,
  "defensa": 6,
  "clase": 0
}

### Iniciar sesión con email
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usuario": "guerrero1@example.com",
  "password": "{{password}}"
}

### Crear partida para un personaje propio
POST {{baseUrl}}/api/partidas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "personajeId": {{personajeId}}
}

### Listar partidas propias
GET {{baseUrl}}/api/partidas
Authorization: Bearer {{token}}

### Obtener partida propia
GET {{baseUrl}}/api/partidas/{{partidaId}}
Authorization: Bearer {{token}}

### Finalizar partida propia
PATCH {{baseUrl}}/api/partidas/{{partidaId}}/finalizar
Authorization: Bearer {{token}}
